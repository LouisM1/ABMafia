{
  "name": "abmafia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node build/server/main.js",
    "debug": "npm run build && DEBUG_AI=true node build/server/main.js",
    "dev": "npm run build && tsx watch server/main.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo": "vite --host 127.0.0.1 --port 4318 --strictPort --open /lounge-demo.html"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.0.0",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0"
  }
}
